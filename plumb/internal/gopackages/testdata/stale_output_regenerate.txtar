The exact reason loader type-error tolerance exists: regenerating over a prior
output file whose own wiring no longer type-checks. NewDB has gained a *Config
parameter, so the old plumb_gen.go's `NewDB()` call no longer compiles. The
loader must tolerate that type error (it is a TypeError, not a structural
failure), discover.Analyze must skip plumb_gen.go (the output base) so its stale
`build` is not fed back, and generation must emit fresh, correct wiring — which
the golden, threaded NewConfig -> NewDB, captures. Build it with the real loader.
-- config --
import-path: example.com/app
package-name: app
output: plumb_gen.go
type-errors: true
-- go.mod --
module example.com/app

go 1.23
-- app.go --
package app

type Config struct{}
type DB struct{}

//plumb:build
func NewConfig() *Config { return &Config{} }

//plumb:build
func NewDB(c *Config) *DB { return &DB{} }
-- plumb_gen.go --
// Code generated by plumb. DO NOT EDIT.

package app

func build() (db *DB) {
	db2 := NewDB()
	db = db2
	return
}
