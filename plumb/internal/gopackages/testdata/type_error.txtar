A valid provider alongside an unrelated type error (an undefined identifier). The
loader tolerates the type error, so generation still runs and is captured in the
golden.
-- config --
import-path: example.com/app
package-name: app
type-errors: true
-- go.mod --
module example.com/app

go 1.23
-- app.go --
package app

type T struct{}

//plumb:build
func A() *T { return nil }

var _ = nonexistent
