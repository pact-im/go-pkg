A variadic parameter is satisfied by a producer of the slice type and forwarded
with the ... spread.
-- config --
import-path: example.com/app
package-name: app
output: plumb_gen.go
-- example.com/app/app.go --
package app

type Option struct{}
type Server struct{}

//plumb:build
func Options() []Option { return nil }

//plumb:build
func NewServer(opts ...Option) *Server { return &Server{} }
