A template that grows its own input would generate ever-deeper instantiations.
-- config --
import-path: example.com/app
package-name: app
error-is: ErrNonTerminating
-- example.com/app/a.go --
package app

type Box[T any] struct{}

//plumb:build
func Grow[T any](b Box[Box[T]]) Box[T] { return Box[T]{} }

//plumb:build
func Use(b Box[int]) int { return 0 }
