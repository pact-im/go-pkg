A //plumb: directive carries only a set name, never arguments. Trailing text
after the name is rejected rather than silently ignored.
-- config --
import-path: example.com/app
package-name: app
error-is: ErrInvalidSetName
-- example.com/app/a.go --
package app

type T struct{}

//plumb:build extra
func New() *T { return &T{} }
