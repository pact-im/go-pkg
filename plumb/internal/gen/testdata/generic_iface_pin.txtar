A generic provider whose result is a literal interface mentioning the type
parameter: unification must look inside the method signature to pin it from the
consumer’s interface{ Get() int } demand.
-- config --
import-path: example.com/app
package-name: app
-- example.com/app/app.go --
package app

type Sink struct{}

//plumb:build
func Getter[T any]() interface{ Get() T } { return nil }

//plumb:build
func Use(g interface{ Get() int }) *Sink { return &Sink{} }
