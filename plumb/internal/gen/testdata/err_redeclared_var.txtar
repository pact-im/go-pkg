A //plumb: directive on a var whose name is already taken by a function: the losing
declaration has no object, so the directive fails loudly instead of silently vanishing.
-- config --
import-path: example.com/app
package-name: app
error-is: ErrInvalidType
-- example.com/app/a.go --
package app

func X() {}

//plumb:build
var X int
