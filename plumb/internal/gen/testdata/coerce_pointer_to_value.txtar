A provider yields *Config; a consumer needs Config by value. plumb bridges by
dereferencing.
-- config --
import-path: example.com/app
package-name: app
output: plumb_gen.go
-- example.com/app/app.go --
package app

type Config struct{ Port int }
type Server struct{}

//plumb:build
func NewConfig() *Config { return &Config{Port: 8080} }

//plumb:build
func NewServer(c Config) *Server { return &Server{} }
