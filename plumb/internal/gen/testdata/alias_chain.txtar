A struct-type provider declared on an alias to an alias to a struct: the alias
chain flattens to the struct, and the value renders as a composite literal of
the outermost alias name.
-- config --
import-path: example.com/app
package-name: app
-- example.com/app/app.go --
package app

type Host string

type config struct{ Host Host }

type mid = config

type Server struct{}

//plumb:build
type Config = mid

//plumb:build
func NewServer(c Config) *Server { return &Server{} }
