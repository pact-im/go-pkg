A //plumb: directive on the keyword of a multi-spec var (...) or const (...) block
applies to every spec in the group, exactly as it does for a single declaration
and for the multiple names within one spec. All four values below are registered
as providers, so the injector needs no inputs.
-- config --
import-path: example.com/app
package-name: app
-- example.com/app/a.go --
package app

type Cfg struct{ Addr string }
type Srv struct{ Name string }
type Port int
type Timeout int
type Built struct{}

//plumb:build
var (
	C = Cfg{}
	S = Srv{}
)

//plumb:build
const (
	P Port    = 8080
	T Timeout = 30
)

//plumb:build
func New(c Cfg, s Srv, p Port, t Timeout) *Built { return &Built{} }
