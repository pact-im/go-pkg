A provider returning only error (no value): it makes the injector fallible and
is called for its check alone.
-- config --
import-path: example.com/app
package-name: app
output: plumb_gen.go
-- example.com/app/app.go --
package app

type Config struct{}
type Server struct{}

//plumb:build
func NewConfig() *Config { return &Config{} }

//plumb:build
func Validate(c *Config) error { return nil }

//plumb:build
func NewServer(c *Config) *Server { return &Server{} }
