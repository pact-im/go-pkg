A //plumb: directive on an import spec is in an unsupported position: imports
are never providers, so the directive is reported rather than silently ignored.
-- config --
import-path: example.com/app
package-name: app
error-is: ErrMisplacedDirective
-- example.com/app/a.go --
package app

import (
	//plumb:build
	"fmt"
)

type T struct{ S string }

//plumb:build
func New() *T { return &T{S: fmt.Sprint(1)} }
