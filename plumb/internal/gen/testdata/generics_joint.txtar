Joint pinning: a multi-result template whose results span different type
parameters, each pinned by its own consumer, instantiated once as NewKVPair[int,
string].
-- config --
import-path: example.com/app
package-name: app
output: plumb_gen.go
-- example.com/app/app.go --
package app

type Key[T any] struct{}
type Value[U any] struct{}
type Store struct{}

//plumb:build
func NewKVPair[T, U any]() (Key[T], Value[U]) { return Key[T]{}, Value[U]{} }

//plumb:build
func NewStore(k Key[int], v Value[string]) *Store { return &Store{} }
