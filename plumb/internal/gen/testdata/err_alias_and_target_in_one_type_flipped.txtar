Mirror of err_alias_and_target_in_one_type with the spellings swapped: the unexported
target comes first in the walk and must be rejected regardless of which spelling the
visited set encounters first. Detection is spelling-order-independent.
-- config --
import-path: example.com/app
package-name: app
error-is: ErrUnreachableType
-- example.com/lib/lib.go --
package lib

type hidden struct{ X int }
type Exported = hidden
type Thing struct{}

//plumb:build
func New(m map[hidden]Exported) *Thing { return &Thing{} }
