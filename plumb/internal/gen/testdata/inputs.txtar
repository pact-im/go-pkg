An unprovided type silently becomes an injector input (a parameter), never an
error. Two consumers of the same input type share one parameter.
-- config --
import-path: example.com/app
package-name: app
output: plumb_gen.go
-- example.com/app/app.go --
package app

type Server struct{}
type Client struct{}

//plumb:build
func NewServer(addr string) *Server { return &Server{} }

//plumb:build
func NewClient(addr string) *Client { return &Client{} }
