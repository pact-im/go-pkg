When a lifted parameter is renamed to avoid a destination identifier (T → T2,
since the package already declares a type T), a co-lifted parameter's constraint
that references it must follow the rename: U interface{ ~[]T } becomes ~[]T2.
-- config --
import-path: example.com/app
package-name: app
-- example.com/app/a.go --
package app

type T struct{}
type Box[X any] struct{}

//plumb:build
func Anchor[T any, U interface{ ~[]T }](a Box[T], b Box[U]) int { return 0 }
