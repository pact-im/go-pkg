A //plumb directive on a member of a blank-named type is rejected: the member
would bind to a receiver of the blank type, which cannot be reached.
-- config --
import-path: example.com/app
package-name: app
error-is: ErrBlankProvider
-- example.com/app/a.go --
package app

type _ struct {
	//plumb:build
	X int
}
