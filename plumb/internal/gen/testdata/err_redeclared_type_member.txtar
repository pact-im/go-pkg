A field directive inside the losing declaration of a redeclared type: the member scan
cannot run without the owner's object, but the directive still fails loudly (located at
the field directive) instead of vanishing with its owner.
-- config --
import-path: example.com/app
package-name: app
error-is: ErrInvalidType
-- example.com/app/a.go --
package app

type T struct{}

type T struct {
	//plumb:build
	N int
}
