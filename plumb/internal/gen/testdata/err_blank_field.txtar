A //plumb directive on a wholly-blank struct-field group declares nothing to wire
and is rejected, the same way scanVar rejects an all-blank var spec.
-- config --
import-path: example.com/app
package-name: app
error-is: ErrBlankProvider
-- example.com/app/a.go --
package app

type C struct {
	//plumb:build
	_ int
}
