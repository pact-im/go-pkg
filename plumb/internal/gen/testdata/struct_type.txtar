A struct-type provider builds itself from the set: exported fields become
inputs, unexported fields are left zero. It produces the value Server.
-- config --
import-path: example.com/app
package-name: app
output: plumb_gen.go
-- example.com/app/app.go --
package app

import "log"

type DB struct{}

//plumb:build
type Server struct {
	Addr string
	DB   *DB
	log  *log.Logger
}

//plumb:build
func NewDB() *DB { return &DB{} }
