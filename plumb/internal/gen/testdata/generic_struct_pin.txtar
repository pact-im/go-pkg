A generic provider whose result is an anonymous struct mentioning the type
parameter: unification must look inside the struct fields to pin it from the
consumer's struct{ V int } demand.
-- config --
import-path: example.com/app
package-name: app
-- example.com/app/app.go --
package app

type Sink struct{}

//plumb:build
func Box[T any]() struct{ V T } { return struct{ V T }{} }

//plumb:build
func Use(s struct{ V int }) *Sink { return &Sink{} }
