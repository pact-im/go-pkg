An alias to func() is a cleanup hook, not an ordinary value: Open’s second
result, typed as the alias Cleanup = func(), is recognized as the teardown.
-- config --
import-path: example.com/app
package-name: app
-- example.com/app/a.go --
package app

type Cleanup = func()
type Conn struct{}

//plumb:build
func Open() (*Conn, Cleanup) { return &Conn{}, func() {} }
