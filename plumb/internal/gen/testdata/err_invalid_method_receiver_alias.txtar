A pointer to a pointer alias is not a valid method receiver. Resolve aliases
around one pointer without accepting additional pointer indirections.
-- config --
import-path: example.com/app
package-name: app
error-is: ErrInvalidType
-- example.com/app/app.go --
package app

type Config struct{}
type Pointer = *Config

//plumb:build
func (*Pointer) Make() int { return 0 }
