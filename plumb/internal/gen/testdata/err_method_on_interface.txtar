A function declaration cannot add a method to an interface type. The loader
tolerates that type error, so reject the provider before instantiation.
-- config --
import-path: example.com/app
package-name: app
error-is: ErrInvalidType
-- example.com/app/app.go --
package app

type Factory interface{}

//plumb:build
func (Factory) Make() int { return 0 }
