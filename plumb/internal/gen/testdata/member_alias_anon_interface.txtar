A //plumb: directive on a method of an alias to an anonymous interface is a
method provider: the method binds to a value of the alias (source.Fetch()), just
as it would to a defined interface type.
-- config --
import-path: example.com/app
package-name: app
output: plumb_gen.go
-- example.com/app/app.go --
package app

type Source = interface {
	//plumb:build
	Fetch() int
}

//plumb:build
func mkSource() Source { return nil }

//plumb:build
func use(x int) string { return "" }
