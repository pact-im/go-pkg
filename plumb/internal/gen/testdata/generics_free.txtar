A free (unpinned) type parameter is lifted to the generated function, which
becomes generic over it. The input-only template PoolSize anchors the set.
-- config --
import-path: example.com/app
package-name: app
output: plumb_gen.go
-- example.com/app/app.go --
package app

type Pool[T any] struct{}

//plumb:build
func NewPool[T any]() *Pool[T] { return &Pool[T]{} }

//plumb:build
func PoolSize[T any](p *Pool[T]) int { return 0 }
