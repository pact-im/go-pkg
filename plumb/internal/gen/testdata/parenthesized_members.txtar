Parentheses around a struct or interface declaration do not change its member
providers. Discover the fields and methods of defined types and aliases alike.
-- config --
import-path: example.com/app
package-name: app
output: plumb_gen.go
-- example.com/app/app.go --
package app

type Config ((struct {
	//plumb:config
	Port int
}))

type Reporter (interface {
	//plumb:report
	Report() bool
})

type Settings = (struct {
	//plumb:settings
	Host string
})

type Source = ((interface {
	//plumb:source
	Fetch() float64
}))
