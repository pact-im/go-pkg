UseKey needs Key[int], which determines Make’s T. UseValue needs Value[string],
which determines Make’s U. Supply both values with one call to Make[int,
string]().
-- config --
import-path: example.com/app
package-name: app
output: plumb_gen.go
-- example.com/app/app.go --
package app

type Factory struct{}
type Key[T any] struct{}
type Value[U any] struct{}

//plumb:build
func (Factory) Make[T, U any]() (Key[T], Value[U]) { return Key[T]{}, Value[U]{} }

//plumb:build
func UseKey(k Key[int]) bool { return true }

//plumb:build
func UseValue(v Value[string]) string { return "" }
