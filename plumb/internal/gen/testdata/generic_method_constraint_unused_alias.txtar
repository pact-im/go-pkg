package app

type Unused[P ~int] = int
type T struct{}
type Factory struct{}

//plumb:build
func (Factory) Make[T ~int, S Unused[T], V ~[]Unused[T], W interface{ Use([]int, []Unused[T]) }](value S, values V, user W) bool {
	return true
}
