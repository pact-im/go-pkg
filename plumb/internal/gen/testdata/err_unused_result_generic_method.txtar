No provider consumes Box[T], so nothing determines Make’s type argument. Reject
the unused method instead of returning Box[T] from the generated function with
an undefined T.
-- config --
import-path: example.com/app
package-name: app
error-is: ErrUnusedTemplate
-- example.com/app/app.go --
package app

type Factory struct{}
type Box[T any] struct{}

//plumb:build
func (Factory) Make[T any]() Box[T] { return Box[T]{} }
