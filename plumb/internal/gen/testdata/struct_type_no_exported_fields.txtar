A struct-type provider whose fields are all unexported: nothing is a wireable input, so
the composite literal is bare (Cache{}) and the unexported fields are left zero. It still
produces the value Cache.
-- config --
import-path: example.com/app
package-name: app
output: plumb_gen.go
-- example.com/app/app.go --
package app

//plumb:build
type Cache struct {
	entries map[string]int
	size    int
}

//plumb:build
func Use(c Cache) int { return c.size }
