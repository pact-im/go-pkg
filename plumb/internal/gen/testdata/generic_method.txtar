Snapshot’s type parameter comes from Cache; the method declares no type
parameters of its own. The receiver carries the type argument, so call
cache.Snapshot().
-- config --
import-path: example.com/app
package-name: app
output: plumb_gen.go
-- example.com/app/app.go --
package app

type User struct{}
type Cache[T any] struct{}
type Snapshot[T any] struct{}
type Report struct{}

//plumb:build
func NewCache[T any]() *Cache[T] { return &Cache[T]{} }

//plumb:build
func (c *Cache[T]) Snapshot() *Snapshot[T] { return &Snapshot[T]{} }

//plumb:build
func NewReport(s *Snapshot[User]) *Report { return &Report{} }
