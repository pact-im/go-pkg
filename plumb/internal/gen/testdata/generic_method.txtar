A method on a generic receiver: the receiver carries its type arguments, so the
call needs none (cache.Snapshot()).
-- config --
import-path: example.com/app
package-name: app
output: plumb_gen.go
-- example.com/app/app.go --
package app

type User struct{}
type Cache[T any] struct{}
type Snapshot[T any] struct{}
type Report struct{}

//plumb:build
func NewCache[T any]() *Cache[T] { return &Cache[T]{} }

//plumb:build
func (c *Cache[T]) Snapshot() *Snapshot[T] { return &Snapshot[T]{} }

//plumb:build
func NewReport(s *Snapshot[User]) *Report { return &Report{} }
