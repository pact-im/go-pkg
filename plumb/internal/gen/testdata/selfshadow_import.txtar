A same-package type named strings collides with the standard-library strings
import the body needs: the import is aliased, and the injector parameter that
would be named after the type is renamed so it shadows neither.
-- config --
import-path: example.com/app
package-name: app
-- example.com/app/app.go --
package app

import strs "strings"

type strings struct{ N int }

//plumb:build
func useReplacer(s strings) *strs.Replacer { return nil }
