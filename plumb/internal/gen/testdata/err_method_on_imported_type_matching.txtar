The imported type already has a method named Make. A tagged declaration in
another package is invalid even when its name and signature match that method.
-- config --
import-path: example.com/app
package-name: app
error-is: ErrInvalidType
-- example.com/x/x.go --
package x

type Factory struct{}

func (Factory) Make() int { return 0 }
-- example.com/app/app.go --
package app

import "example.com/x"

//plumb:build
func (x.Factory) Make() int { return 0 }
