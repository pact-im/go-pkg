A single declaration carrying two directives joins two sets, appearing in both
generated functions.
-- config --
import-path: example.com/app
package-name: app
output: plumb_gen.go
-- example.com/app/app.go --
package app

type Clock struct{}
type App struct{}
type Test struct{}

//plumb:build
//plumb:test
func NewClock() *Clock { return &Clock{} }

//plumb:build
func NewApp(c *Clock) *App { return &App{} }

//plumb:test
func NewTest(c *Clock) *Test { return &Test{} }
