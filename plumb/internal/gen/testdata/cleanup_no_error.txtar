A cleanup provider with no error result: the injector returns an aggregated
cleanup but is not fallible.
-- config --
import-path: example.com/app
package-name: app
output: plumb_gen.go
-- example.com/app/app.go --
package app

type Conn struct{}

//plumb:build
func Open() (*Conn, func()) { return &Conn{}, func() {} }
