A group-level directive and a spec-level directive are unioned, not mutually
exclusive: X carries its own //plumb:test yet still inherits the group's
//plumb:build, so it joins both sets instead of silently dropping out of build.
Y, with no directive of its own, joins only build.
-- config --
import-path: example.com/app
package-name: app
output: plumb_gen.go
-- example.com/app/app.go --
package app

type A struct{}
type B struct{}

//plumb:build
var (
	//plumb:test
	X = A{}
	Y = B{}
)
