A type and an alias to it are the same type, so producers of each are an ambiguity.
-- config --
import-path: example.com/app
package-name: app
error-is: ErrAmbiguousProducer
-- example.com/app/a.go --
package app

type Real struct{}
type Alias = Real

//plumb:build
func A() Real { return Real{} }

//plumb:build
func B() Alias { return Alias{} }
