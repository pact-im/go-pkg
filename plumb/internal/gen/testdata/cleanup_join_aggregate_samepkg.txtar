Two failable cleanups are joined in the errors package itself. Call Join
without a qualifier and avoid importing errors into itself.
-- config --
import-path: errors
package-name: errors
output: plumb_gen.go
-- errors/errors.go --
package errors

type A struct{}
type B struct{}

//plumb:build
func OpenA() (A, func() error) { return A{}, func() error { return nil } }

//plumb:build
func OpenB(value A) (B, func() error) { return B{}, func() error { return nil } }

func Join(errs ...error) error { return nil }
