Get’s type parameter comes from Cache; the method declares no type parameters
of its own. The receiver carries the unexported type x.secret, so the generated
code can call cache.Get() without naming that type. Accept this because
x.secret is used only in local variables and never appears in the generated
function’s parameters or return values.
-- config --
import-path: example.com/app
package-name: app
output: plumb_gen.go
-- example.com/x/x.go --
package x

type secret struct{}
type Cache[T any] struct{}
type Box[T any] struct{}
type Out struct{}

//plumb:build
func MakeCache() *Cache[secret] { return &Cache[secret]{} }

//plumb:build
func (c *Cache[T]) Get() Box[T] { return Box[T]{} }

//plumb:build
func Consume(b Box[secret]) *Out { return &Out{} }
