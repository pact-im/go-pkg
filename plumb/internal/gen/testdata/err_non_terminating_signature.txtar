A template that grows through a function type (Grow needs Box[func(T)] to produce
Box[T]) manufactures Box[func(func(...(int)))] without bound. The depth bound must
see through the func type (not treat it as a flat leaf) so this trips the depth
limit in a few dozen instantiations rather than grinding to the instantiation cap.
-- config --
import-path: example.com/app
package-name: app
error-is: ErrNonTerminating
-- example.com/app/a.go --
package app

type Box[T any] struct{ V T }

//plumb:build
func Grow[T any](b Box[func(T)]) Box[T] { return Box[T]{} }

//plumb:build
func Use(b Box[int]) string { return "" }
