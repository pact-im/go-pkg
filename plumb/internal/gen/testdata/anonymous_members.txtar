Unexported and blank members of anonymous types can be repeated in their own
package. Keep both output types in the generated signature.
-- config --
import-path: example.com/app
package-name: app
output: plumb_gen.go
-- example.com/app/app.go --
package app

//plumb:build
func NewRecord() struct { hidden int; _ string } {
	return struct { hidden int; _ string }{}
}

//plumb:build
func NewSource() interface{ hidden() } { return nil }
