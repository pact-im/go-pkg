A struct-type provider with an embedded exported field: the field has no name of
its own, so the composite literal keys it by the embedded type's base name
(Server{DB: db, ...}). Unexported and named fields alongside it behave as usual.
-- config --
import-path: example.com/app
package-name: app
output: plumb_gen.go
-- example.com/app/app.go --
package app

type DB struct{}

//plumb:build
type Server struct {
	DB
	Addr string
}

//plumb:build
func NewDB() DB { return DB{} }
