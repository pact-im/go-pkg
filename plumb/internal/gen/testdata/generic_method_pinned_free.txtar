Use needs Box[int], so Make’s S must be int. Nothing determines the receiver’s
R, so declare R on the generated function and accept a Factory[R] parameter.
The method call is factory.Make[int]().
-- config --
import-path: example.com/app
package-name: app
output: plumb_gen.go
-- example.com/app/app.go --
package app

type Factory[R any] struct{}
type Box[S any] struct{}

//plumb:build
func (Factory[R]) Make[S any]() Box[S] { return Box[S]{} }

//plumb:build
func Use(b Box[int]) bool { return true }
