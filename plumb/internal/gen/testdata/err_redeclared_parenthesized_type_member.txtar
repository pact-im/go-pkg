A member directive in a parenthesized, redeclared type must report the unusable
declaration, just as it would without the parentheses.
-- config --
import-path: example.com/app
package-name: app
error-is: ErrInvalidType
-- example.com/app/app.go --
package app

type Config struct{}

type Config (struct {
	//plumb:build
	Port int
})
