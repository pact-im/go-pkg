The anonymous types have unexported members, but appear only in local values.
Pass those values directly between providers without naming their types.
-- config --
import-path: example.com/app
package-name: app
output: plumb_gen.go
-- example.com/x/x.go --
package x

//plumb:build
func NewRecord() struct{ hidden int } { return struct{ hidden int }{} }

//plumb:build
func UseRecord(value struct{ hidden int }) int { return 0 }

//plumb:build
func NewSource() interface{ hidden() } { return nil }

//plumb:build
func UseSource(value interface{ hidden() }) bool { return true }
