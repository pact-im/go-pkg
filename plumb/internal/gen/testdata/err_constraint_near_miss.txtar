A consumer demands Box[int], which structurally matches the template's result
Box[T] and pins T=int, but int violates T's Stringer constraint, so the template
cannot be instantiated. The demand silently becomes an injector input (unprovided
means input), leaving the template with no successful consumer; the diagnostic
reports the real constraint reason rather than a misleading "no consumer pins it".
-- config --
import-path: example.com/app
package-name: app
error-is: ErrUnusedTemplate
-- example.com/app/a.go --
package app

type Stringer interface{ String() string }

type Box[T Stringer] struct{}

//plumb:build
func Make[T Stringer]() Box[T] { return Box[T]{} }

//plumb:build
func Use(b Box[int]) int { return 0 }
