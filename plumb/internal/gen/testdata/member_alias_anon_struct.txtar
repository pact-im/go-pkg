A //plumb: directive on a field of an alias to an anonymous struct is a field
provider: the field binds to a value of the alias (s.X), just as it would to a
defined struct type. The owner need not be a defined type.
-- config --
import-path: example.com/app
package-name: app
output: plumb_gen.go
-- example.com/app/app.go --
package app

type S = struct {
	//plumb:build
	X int
}

//plumb:build
func mkS() S { return S{X: 7} }

//plumb:build
func use(x int) string { return "" }
