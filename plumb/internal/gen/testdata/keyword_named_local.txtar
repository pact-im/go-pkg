A value local derived from a keyword-named type keeps a readable, suffixed name.
NewType produces *Type, whose local base "type" is a keyword; the allocator suffixes it
to "type2" rather than collapsing it to a generic "v".
-- config --
import-path: example.com/app
package-name: app
-- example.com/app/a.go --
package app

type Type struct{}
type Sink struct{}

//plumb:build
func NewType() *Type { return &Type{} }

//plumb:build
func NewSink(t *Type) *Sink { return &Sink{} }
