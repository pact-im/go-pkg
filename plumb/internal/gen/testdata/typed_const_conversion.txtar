A constant typed via conversion (const X = Port(8080)) is a valid typed-constant
provider.
-- config --
import-path: example.com/app
package-name: app
output: plumb_gen.go
-- example.com/app/app.go --
package app

type Port int
type Server struct{}

//plumb:build
const DefaultPort = Port(8080)

//plumb:build
func NewServer(p Port) *Server { return &Server{} }
