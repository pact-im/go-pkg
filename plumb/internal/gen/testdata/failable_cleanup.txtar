Failable cleanup: a provider returning func() error. The aggregated cleanup
becomes func() error; a single teardown error is captured in a local and
returned directly, so neither errors.Join nor the errors import appears.
-- config --
import-path: example.com/app
package-name: app
output: plumb_gen.go
-- example.com/app/app.go --
package app

import "database/sql"

//plumb:setup
func OpenDB(dsn string) (*sql.DB, func() error, error) {
	return nil, func() error { return nil }, nil
}
