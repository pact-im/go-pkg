Make names its parameter int, but the generated function must leave that name
available for the predeclared type. Use the new parameter name in Unused too.
-- config --
import-path: example.com/app
package-name: app
output: plumb_gen.go
-- example.com/app/app.go --
package app

type Unused[P ~string] = string
type Factory struct{}

//plumb:build
func (Factory) Make[int ~string, S Unused[int]](value S) bool { return true }
