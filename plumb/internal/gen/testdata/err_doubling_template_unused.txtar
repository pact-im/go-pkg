An output-side doubling template can never unify with the concrete demand, so it is unpinnable.
-- config --
import-path: example.com/app
package-name: app
error-is: ErrUnusedTemplate
-- example.com/app/a.go --
package app

type Pair[T any] struct{}

//plumb:build
func Dup[T any](x Pair[T]) Pair[Pair[T]] { return Pair[Pair[T]]{} }

//plumb:build
func Use(p Pair[int]) int { return 0 }
