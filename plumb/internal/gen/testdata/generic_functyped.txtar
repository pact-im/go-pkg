A generic provider whose result is a function type mentioning the type
parameter: unification must look inside the signature to pin it from the
consumer's func(int) int demand.
-- config --
import-path: example.com/app
package-name: app
-- example.com/app/app.go --
package app

type Thing struct{}

//plumb:build
func NewMapper[T any]() func(T) T { return func(x T) T { return x } }

//plumb:build
func Use(m func(int) int) *Thing { return &Thing{} }
