A method declared inside an interface is a provider whose receiver is the
interface value: it consumes the interface and produces the result
(reporter.Report()).
-- config --
import-path: example.com/app
package-name: app
output: plumb_gen.go
-- example.com/app/app.go --
package app

type Summary struct{}

type Reporter interface {
	//plumb:build
	Report() *Summary
}

//plumb:build
func Use(s *Summary) int { return 0 }
