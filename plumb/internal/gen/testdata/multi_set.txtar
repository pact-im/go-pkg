Two independent sets in one file produce two functions, emitted in deterministic
(sorted) set-name order.
-- config --
import-path: example.com/app
package-name: app
output: plumb_gen.go
-- example.com/app/app.go --
package app

type A struct{}
type B struct{}

//plumb:alpha
func NewA() *A { return &A{} }

//plumb:beta
func NewB() *B { return &B{} }
