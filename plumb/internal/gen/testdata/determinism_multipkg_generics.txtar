Providers spread across several files and two packages, with some tying on byte
offset across files, plus generics: a result-generic template pinned at two
types, a free type parameter lifted onto the injector, and a joint-pinning split
template instantiated at two distinct pinnings by two consumers. A determinism
stress fixture: the corpus reloads every fixture under shuffled package and file
order, so anything here that leaked read order or map-iteration order would
produce a non-byte-identical re-run.
-- config --
import-path: example.com/web
package-name: web
output: plumb_gen.go
-- example.com/store/a.go --
package store
type Config struct{}
//plumb:build
func NewConfig() *Config { return &Config{} }
-- example.com/store/b.go --
package store
type DB struct{}
//plumb:build
func NewDB(c *Config) (*DB, error) { return &DB{}, nil }
-- example.com/store/c.go --
package store
type Cache struct{}
//plumb:build
func NewCache(c *Config) *Cache { return &Cache{} }
-- example.com/store/g.go --
package store
type User struct{}
type Admin struct{}
type Box[T any] struct{}
