//plumb:build
func NewBox[T any]() *Box[T] { return &Box[T]{} }
//plumb:build
func NewPool[T any]() *Pool[T] { return &Pool[T]{} }
//plumb:build
func PoolUser[T any](p *Pool[T]) string { return "" }
-- example.com/store/h.go --
package store
type Key[T any] struct{}
type Val[U any] struct{}
type Pair1 struct{}
type Pair2 struct{}
//plumb:build
func NewKV[T, U any]() (Key[T], Val[U]) { return Key[T]{}, Val[U]{} }
//plumb:build
func UsePair1(k Key[User], v Val[Admin]) *Pair1 { return &Pair1{} }
//plumb:build
func UsePair2(k Key[Admin], v Val[User]) *Pair2 { return &Pair2{} }
-- example.com/web/web.go --
package web
import "example.com/store"
type Server struct{}
//plumb:build
func NewServer(db *store.DB, ca *store.Cache, bu *store.Box[store.User], ba *store.Box[store.Admin], p1 *store.Pair1, p2 *store.Pair2) (*Server, func(), error) {
	return &Server{}, func() {}, nil
}
