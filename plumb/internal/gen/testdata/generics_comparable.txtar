A free type parameter constrained by the predeclared comparable travels to the
generated function as comparable, not any.
-- config --
import-path: example.com/app
package-name: app
output: plumb_gen.go
-- example.com/app/app.go --
package app

type Set[T comparable] struct{}

//plumb:build
func NewSet[T comparable]() *Set[T] { return &Set[T]{} }

//plumb:build
func Size[T comparable](s *Set[T]) int { return 0 }
